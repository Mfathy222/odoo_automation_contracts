<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="zofirm_4400_contract_full_template" name="4400 contract">
    <main class="page o_report_layout">
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@emran-alhaddad/saudi-riyal-font/index.css" />
      <style>
          @import url('https://fonts.cdnfonts.com/css/sakkal-majalla-2');
          .header:not(.my_rtl_header), .o_header:not(.my_rtl_header), header:not(.my_rtl_header) { display:none !important; }
          .tbl { border-style: hidden;}
          .th,td {border: 0px; border-style: hidden;}
          .contract-body { direction: rtl; text-align: right;
            font-family: 'Sakkal Majalla', 'Majalla', Tahoma, Arial, sans-serif !important;
            font-size: 20px; line-height: 1.75; color: #000000; }
          .contract-section-title { direction: rtl; text-align: right; font-weight: bold;
            font-size: 20px; line-height: 1.6; page-break-after: avoid; }
          .contract-paragraph, .contract-paragraph1 {
            direction: rtl; text-align: right; font-size: 20px; line-height: 1.75;
            padding: 0; border: 0 !important;
          }
      </style>
      <t t-foreach="docs or (doc and [doc]) or []" t-as="o">
        <t t-set="q0" t-value="(o and (o._name in ('sijil.contract','zofirm.contract') and o.quotation_id)) or (o and o._name == 'sale.order' and o) or False"/>
        <t t-set="q" t-value="q0 and q0._name == 'sale.order' and q0 or False"/>
        <t t-set="partner" t-value="q and q.partner_id or False"/>
        <t t-set="contract_ref" t-value="(q and (q.name or q.client_order_ref)) or ''"/>
        <t t-set="fee_base" t-value="(q and q.amount_untaxed) or 0.0"/>
        <t t-set="vat_rate" t-value="0.15"/>
        <t t-set="vat_amount" t-value="fee_base * vat_rate"/>
        <t t-set="grand_total" t-value="fee_base + vat_amount"/>
        <t t-set="auth_person" t-value="o.partner_id.commercial_partner_id.authorized_person or False"/>
        <t t-set="auth_title" t-value="(auth_person and auth_person.function) or ''"/>

        <div style="direction:rtl;line-height:1.5;font-size:20px;font-family:'Sakkal Majalla',sans-serif !important;">
          <div style="margin:0 0 10px 0; text-align:left;">
            <span t-if="o.end_date_number" t-esc="o.end_date_number"/> / 
            <span t-esc="contract_ref"/>
