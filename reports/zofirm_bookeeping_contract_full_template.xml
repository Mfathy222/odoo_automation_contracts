<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="zofirm_bookeeping_contract_full_template" name="Bookeeping contract">
    <main class="page o_report_layout">
      <t t-set="q" t-value="(o._name == 'sale.order' and o) or (('quotation_id' in o._fields and o.quotation_id) or ('order_id' in o._fields and o.order_id) or False)"/>
      <t t-set="partner" t-value="q and q.partner_id or False"/>
      <t t-set="partner_lang" t-value="(partner and partner.lang) or 'ar_001'"/>
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@emran-alhaddad/saudi-riyal-font/index.css" />
      <style>
      @import url('https://fonts.cdnfonts.com/css/sakkal-majalla-2');
      .contract-page { direction: rtl; text-align: right;
        font-family: 'Sakkal Majalla', sans-serif !important;
        font-size: 18px; line-height: 1.9; }
      .title { text-align: center; font-size: 30px; font-weight: 800; margin: 0 0 10px 0; }
      .section-title { margin: 18px 0 6px 0; font-size: 22px; font-weight: 800; }
      .para { margin: 6px 0; }
      .bullets { margin: 6px 0 10px 0; padding-right: 22px; }
      .bullets li { margin: 4px 0; }
      .doc-table { width: 100%; border-collapse: collapse; margin: 10px 0; font-size: 18px; }
      .doc-table td, .doc-table th { padding: 0px 10px; vertical-align: top; }
      .sign-table td { height: 60px; }
      .contract-paragraph, .contract-paragraph1, .para {
        direction: rtl; text-align: right; font-size: 20px; line-height: 1.75;
        padding: 0; border: 0 !important;
      }
      </style>

      <div class="contract-page">
        <h2 class="title text-dark">..............................................................</h2>

