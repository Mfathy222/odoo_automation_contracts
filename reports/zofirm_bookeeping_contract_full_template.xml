        <h4 class="section-title">..............................................................</h4>
        <p class="para">..............................................................</p>

        <ul class="bullets">
          <t t-set="product_items" t-value="q and q.sow_item_ids.filtered(lambda item: item.item_kind == 'product').sorted(key=lambda item: item.display_order) or []"/>
          <t t-foreach="product_items" t-as="product_item">
            <li class="bullet-section">..............................................................</li>
            <t t-set="selected_lines" t-value="q.sow_item_ids.filtered(lambda item: item.sale_order_line_id == product_item.sale_order_line_id and item.item_kind == 'line' and item.selected).sorted(key=lambda item: item.display_order)"/>
            <ul t-if="selected_lines" class="bullets">
              <t t-foreach="selected_lines" t-as="line_item">
                <li>..............................................................</li>
                <t t-set="selected_sublines" t-value="q.sow_item_ids.filtered(lambda item: item.sale_order_line_id == product_item.sale_order_line_id and item.sow_line_id == line_item.sow_line_id and item.item_kind == 'subline' and item.selected).sorted(key=lambda item: item.display_order)"/>
                <ul t-if="selected_sublines" class="bullets">
                  <t t-foreach="selected_sublines" t-as="subline_item">
                    <li>..............................................................</li>
                  </t>
