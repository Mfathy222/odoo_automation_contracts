<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="sijil_contract_full_template" name="Sijil Contract Document">
    <main class="page rtl o_report_layout">
      <style>
          @import url('https://fonts.cdnfonts.com/css/sakkal-majalla-2');
          .rtl { direction: rtl; text-align: right; font-family: 'Sakkal Majalla', sans-serif !important;}
          .sec { font-size: 14pt; font-weight: bold; margin: 16px 0 6px 0; color: #1e5397;}
          .ul { margin: 0 0 8px 0; padding-right: 19px; }
          .ul li { margin: 2px 0; font-size:20px; }
          .tbl { width:100%; margin: 6px 0 14px 0; text-align:center; border-style: hidden;}
          .th,td {border: 0px; border-style: hidden;}
          .sign { margin-top: 19px; font-size:20px;}
          .header:not(.my_rtl_header), .o_header:not(.my_rtl_header), header:not(.my_rtl_header) { display:none !important; }
      </style>
      <t t-set="o" t-value="doc or (docs and docs[0])"/>
      <t t-set="is_contract" t-value="o and (o._name in ('sijil.contract','zofirm.contract'))"/>
      <t t-set="q" t-value="is_contract and o.quotation_id or o"/>
      <t t-set="lines" t-value="(is_contract and o.order_line_ids) or (q and q._name == 'sale.order' and q.order_line) or []"/>
      <t t-set="dt" t-value="(o and (o.create_date or (q and q.date_order) or o.write_date))"/>
      <t t-set="anmt_total" t-value="q and (q.amount_untaxed or 0.0) or 0.0"/>

      <div style="margin-bottom:20px !important; margin-top:20px; padding: 0px 15px 0px 15px;">
        <div class="title fw-bold">..............................................................</div>
        <h5 class="muted">..............................................................</h5>
        <h5 class="muted">..............................................................</h5>
        <h5 class="muted">..............................................................</h5>

        <div class="sec">..............................................................</div>
        <h5 class="muted">..............................................................</h5>

        <div class="sec">..............................................................</div>
        <h5 class="muted">..............................................................</h5>

        <div class="sec">..............................................................</div>
        <h5>..............................................................</h5>

        <t t-if="lines">
          <ul class="ul">
            <t t-set="i" t-value="0"/>
            <t t-foreach="lines" t-as="l">
              <t t-if="l.display_type == 'line_section'">
                <li style="list-style: none;"><b>..............................................................</b></li>
              </t>
              <t t-if="not l.display_type">
                <t t-set="i" t-value="i + 1"/>
                <li style="list-style: none;">..............................................................</li>
              </t>
            </t>
          </ul>
        </t>

        <h5>..............................................................</h5>
        <ul class="ul" style="font-size:20px;">
          <li style="font-size:20px;">..............................................................</li>
          <li style="font-size:20px;">..............................................................</li>
          <li style="font-size:20px;">..............................................................</li>
          <li style="font-size:20px;">..............................................................</li>
        </ul>

        <div class="sec">..............................................................</div>
        <h5 class="muted">..............................................................</h5>

        <div class="sec">..............................................................</div>
        <h5 class="muted">..............................................................</h5>

        <t t-set="fees_lines" t-value="q.fees_payment_line_ids"/>
        <t t-set="show_due_stage" t-value="fees_lines and any((l.due_stage for l in fees_lines))"/>

        <table class="tbl" style="border-style: hidden; font-size: 20px;">
          <thead style="border:0!important;">
            <tr>
              <th style="border:0!important; color:black; font-size:20px;">..............</th>
              <th style="border:0!important; color:black; font-size:20px;">..............</th>
              <th style="border:0!important; color:black; font-size:20px;">..............</th>
              <th t-if="show_due_stage" style="border:0!important; color:black; font-size:20px;">..............</th>
            </tr>
          </thead>
          <tbody style="border:0!important;">
            <t t-if="fees_lines">
              <tr t-foreach="fees_lines" t-as="f" style="border:0!important;">
                <td style="border:0!important; font-size:20px;">..............</td>
                <td style="border:0!important; font-size:20px;">..............</td>
                <td style="border:0!important; font-size:20px;">..............</td>
                <td t-if="show_due_stage" style="border:0!important; font-size:20px;">..............</td>
              </tr>
            </t>
          </tbody>
        </table>

        <h5>..............................................................</h5>
        <table class="tbl narrow" style="border-style: hidden;">
          <tr><th style="border:0!important; font-size:20px;">..............</th><td style="border:0!important; font-size:20px;">..............................</td></tr>
          <tr><th style="border:0!important; font-size:20px;">..............</th><td style="border:0!important; font-size:20px;">..............................</td></tr>
          <tr><th style="border:0!important; font-size:20px;">..............</th><td style="border:0!important; font-size:20px;">..............................</td></tr>
          <tr><th style="border:0!important; font-size:20px;">..............</th><td style="border:0!important; font-size:20px;">..............................</td></tr>
        </table>

        <div class="sec">..............................................................</div>
        <div class="muted">
          <h5><b>..........................:</b><br/>..............................................................</h5>
          <h5><b>..........................:</b><br/>..............................................................</h5>
          <h5><b>..........................:</b><br/>..............................................................</h5>
        </div>

        <div class="sec">..............................................................</div>
        <li style="font-size:22px;">..............................................................</li>
        <li style="font-size:22px;">..............................................................</li>
        <li style="font-size:22px;">..............................................................</li>

        <div class="sec">..............................................................</div>
        <h5 class="muted">..............................................................</h5>

        <div class="sec">..............................................................</div>
        <div class="muted">
          <h5>1- ..............................................................</h5>
          <h5>2- ..............................................................</h5>
          <h5>3- ..............................................................</h5>
          <h5>4- ..............................................................</h5>
          <h5>5- ..............................................................</h5>
          <h5>..............................................................</h5>
        </div>

        <div class="sec">..............................................................</div>
        <h5 class="muted">..............................................................</h5>

        <t t-set="schedule_lines" t-value="(is_contract and (o.contract_schedule_line_ids or (q and q.project_schedule_line_ids))) or (q and q.project_schedule_line_ids)"/>
        <t t-if="schedule_lines">
          <h5 class="sec">..............................................................</h5>
          <div style="margin-right:50px;">
            <table class="tbl" style="width:100%; border:none;">
              <thead style="border:none;">
                <tr>
                  <th style="border:none!important; font-size:20px;">..............</th>
                  <th style="border:none!important; font-size:20px;">..............</th>
                  <th style="border:none!important; font-size:20px;">..............</th>
                  <th style="border:none!important; font-size:20px;">..............</th>
                </tr>
              </thead>
              <tbody style="border:none;">
                <tr t-foreach="schedule_lines" t-as="s" style="border:none;">
                  <td t-esc="s_index + 1" style="border:none!important; font-size:20px;"/>
                  <td style="border:none!important; font-size:20px;">..............................................................</td>
                  <td style="border:none!important; font-size:20px;">..............</td>
                  <td style="border:none!important; font-size:20px;">..............</td>
                </tr>
              </tbody>
            </table>
          </div>
        </t>

        <table class="tbl sign" style="border-style: hidden;">
          <tr>
            <td style="width:50%; border:0!important;">
              <b style="font-size:20px; color:#1e5397;">...................</b><br/><br/>
              ..............................................................<br/><br/>
              ..............................................................<br/><br/>
              ..............................................................
            </td>
            <td style="width:50%; border:0!important;">
              <b style="font-size:20px; color:#1e5397;">...................</b><br/><br/>
              ..............................................................<br/><br/>
              ..............................................................<br/><br/>
              ..............................................................
            </td>
          </tr>
        </table>
      </div>
    </main>
  </template>
</odoo>