  </template>

  <record id="action_report_zofirm_contract" model="ir.actions.report">
    <field name="paperformat_id" ref="zofirm_contract.paperformat_zofirm_contracts"/>
    <field name="name">zofirm Contract</field>
    <field name="model">zofirm.contract</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">zofirm_contract.zofirm_report_contract_document</field>
    <field name="report_file">zofirm_contract.zofirm_report_contract_document</field>
    <field name="print_report_name">"عقد %s" % (object.partner_id.name or "")</field>
  </record>

