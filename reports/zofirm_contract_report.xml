      <t t-else="">

        <div id="sijil_footer" style="width: 100%;direction: rtl;text-align: right;padding: 25px 18px 0 0;box-sizing: border-box;">
          <div style="display: table;width: 100%;direction: rtl;table-layout: fixed;">
            <div style="display: table-row;">
              <!-- الخط الأزرق كـ Div منفصل -->
              <div style="display: table-cell;width: 12px;vertical-align: top;">
                <div style="width: 9px;height: 108px;background-color: #1e5397;border-radius: 6px;margin: 0 auto;"></div>
              </div>
              <!-- محتوى الفوتر -->
              <div style="display: table-cell;vertical-align: top;color: #1e5397;font-size: 13pt;line-height: 1.50;font-weight: 400;text-align: right;direction: rtl;padding-top: 5px; padding-right: 12px;">
                <div style="direction: rtl; text-align: right; color: #1e5397; font-size:11pt; line-height: 1.50;">
