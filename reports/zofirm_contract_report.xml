<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="paperformat_zofirm_contracts" model="report.paperformat">

    <field name="name">Zofirm Contracts</field>
    <field name="default" eval="False"/>
    <field name="format">A4</field>
    <field name="orientation">Portrait</field>

    <field name="margin_top">30</field>
    <!-- <field name="margin_top">50</field> -->
    <field name="margin_bottom">32</field>
    <field name="margin_left">5</field>
    <field name="margin_right">5</field>

    <field name="header_line" eval="False"/>
    <field name="header_spacing">25</field>
    <!-- <field name="header_spacing">45</field> -->
    <field name="disable_shrinking" eval="False"/>
    <field name="dpi">90</field>

  </record>

  <template id="zofirm_report_bookeeping_contract_document" name="Bookeeping Contract Document">
    <t t-set="o" t-value="doc or (docs and docs[0])"/>
    <t t-set="company" t-value="o.company_id or env.company"/>
    <xpath expr="//div[contains(@t-attf-class, 'header o_company_')]" position="replace">
      <div class="header my_rtl_header" style="direction: rtl; text-align: center;">
        <t t-set="att_Untitllled" t-value="env['ir.attachment'].sudo().search([('name','=','Elzamil_Untitllled')], limit=1)"/>
        <t t-set="Untitllled_b64" t-value="(att_Untitllled.datas  and att_Untitllled.datas.decode().replace('\n','').replace('\r','')) or ''"/>
        <img class="o-inline-Untitllled" t-attf-src="data:#{att_Untitllled.mimetype or 'image/png'};base64,#{Untitllled_b64}" style="float:right; margin-right: -7px !important; max-width: 350px;"/>
      </div>
    </xpath>
    <t t-call="zofirm_contract.external_layout_rtl">
      <t t-call="zofirm_contract.zofirm_bookeeping_contract_full_template"/>
    </t>
  </template>

