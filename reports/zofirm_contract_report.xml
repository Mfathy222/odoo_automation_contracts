                </div>
                <div style="direction: ltr;text-align: right;color: #1e5397;line-height: 1.50;">
                  <a href="" style="text-decoration: none !important;color: #1e5397 !important; font-size:11pt;">
                        www.sijilacc.com
                  </a>
                </div>
                <div style="direction: ltr;text-align: right;color: #1e5397;line-height: 1.50;">
                  <a href="" style="text-decoration: none !important;color: #1e5397 !important; font-size:11pt;">
                        info@sijilacc.com
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
