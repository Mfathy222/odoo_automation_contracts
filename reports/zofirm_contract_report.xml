  <template id="external_layout_rtl" inherit_id="web.external_layout_standard" priority="50">

    <xpath expr="//div[1]" position="before">
      <t t-if="not o" t-set="o" t-value="company"/>
    </xpath>

    <xpath expr="//div[hasclass('o_footer_content')]" position="replace">
      <!-- company.id != 2 -->
      <t t-if="company.id != 2">
        <div class="zofirm-footer">
          <div id="zofirm_footer" style="direction:rtl; text-align:right; padding-top: 8px !important;">
            <div class="line" style="color:#ABA7A7;font-size:11pt; border-top: 1px solid #111827 !important; padding-top: 8px !important;">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-telephone-fill" viewBox="0 0 16 16">
