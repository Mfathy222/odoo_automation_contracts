<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="custom_external_layout_striped_header_only_shape" inherit_id="web.external_layout_striped" priority="50">
        <xpath expr="//div[contains(@t-attf-class, 'header')]" position="replace">
            <div t-attf-class="o_company_#{company.id}_layout header" style="width: 100%;max-width: none;margin: 0;padding: 0;direction: ltr;box-sizing: border-box;">
                <div style="display: block;height: 35px;background: #1e5397;margin: 0 -50px 20px -50px;padding: 0;border: 0;box-sizing: border-box;"></div>
                <table style="width: 100%;border-collapse: collapse;table-layout: fixed;direction: ltr;margin: 0;padding: 0;border: 0 !important;">
                    <tbody style="border: 0 !important;">
                        <tr style="border: 0 !important;">
                            <td name="company_address" style="width: 60%;vertical-align: top;text-align: left;padding-left: 0;padding-right: 0;direction: ltr;border: 0 !important;">
                                <div style="padding-left: 30px; box-sizing: border-box;">
                                    <ul class="list-unstyled" name="company_address_list" style="margin: 0;padding: 0;list-style: none;text-align: left;direction: ltr; ">
                                        <li t-if="company.is_company_details_empty">
                                            <span t-field="company.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: true}">
                                                <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                                    <strong>Company address block</strong>
                                                    <div>Contains the company address.</div>
                                                </div>
                                            </span>
                                        </li>
                                        <li t-else="">
                                            <span t-field="company.company_details">
                                                <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                                    <strong>Company details block</strong>
                                                    <div>Contains the company details.</div>
                                                </div>
                                            </span>
                                        </li>
                                        <li t-if="not forced_vat"></li>
                                        <li t-else="">
                                            <t t-esc="company.country_id.vat_label or 'Tax ID'">Tax ID</t>:
                                            <span t-esc="forced_vat">US12345671</span>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                            <td style="width: 100%;vertical-align: top;text-align: right;padding-left: 0;padding-right: 10px;direction: ltr;border: 0 !important;">
                                <div style="width: 100%;text-align: right;direction: ltr;box-sizing: border-box;">
                                    <img t-if="company.logo" class="o_company_logo_big" t-att-src="image_data_uri(company.logo)" alt="Logo" style="max-width: 120px;max-height: 150px;width: auto;height: auto; padding-right: 20px;"/>
                                    <div t-if="company.report_header" t-field="company.report_header" class="o_company_tagline fw-bold mt-2" style="font-size: 15px;text-align: right;direction: rtl;unicode-bidi: embed;color: #383636;">
                                    Company tagline
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div style="display: block;border-bottom: 1px solid #6c98c9;margin: 5px 50px 0 50px;padding: 0;border-left: 0;border-right: 0;box-sizing: border-box;"></div>
            </div>
        </xpath>
    </template>

