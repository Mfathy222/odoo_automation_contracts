<template id="custom_sale_report_customer_address_rtl_ltr_fixed"
          inherit_id="sale.report_saleorder_document"
          priority="100">

    <xpath expr="//t[@t-set='address']" position="replace">

        <t t-set="partner_lang" t-value="doc.partner_id.lang or ''"/>
        <t t-set="is_arabic_partner" t-value="partner_lang[:2] == 'ar'"/>

        <t t-set="address">
            
            <style type="text/css">
                
                div.address.row {
                    display: block !important;
                    width: 100% !important;
                    max-width: 100% !important;
                    margin-left: 0 !important;
                    margin-right: 0 !important;
                    padding-left: 0 !important;
                    padding-right: 0 !important;
                    clear: both !important;
                    overflow: visible !important;
                }

                div.address.row > div[name="address"] {
                    display: block !important;
                    width: 100% !important;
                    max-width: 100% !important;
                    flex: none !important;
                    float: none !important;
                    margin-left: 0 !important;
                    margin-right: 0 !important;
                    padding-left: 0 !important;
                    padding-right: 0 !important;
                    overflow: visible !important;
                }

                .customer_address_ar,
                .customer_address_en {
                    display: block !important;
                    page-break-inside: avoid !important;
                    overflow: visible !important;
                    color: #000000 !important;
                }

                .customer_address_ar,
                .customer_address_ar * {
                    direction: rtl !important;
                    text-align: right !important;
                }

                .customer_address_en,
                .customer_address_en * {
                    direction: ltr !important;
                    text-align: left !important;
                }

                 .o_snail_mail .address {
                        padding-top: 0px !important;
                    }
            </style>

            <t t-if="is_arabic_partner">
                <div class="customer_address_ar"
                     dir="rtl"
                     style="width: 42%; margin-left: auto; margin-right: 0; text-align: right; direction: rtl; font-size: 15px; line-height: 1.35; font-weight: 600;">

                    <div t-field="doc.partner_id"
                         class="mb-0"
                         t-options="{'widget': 'contact', 'fields': ['address', 'name'], 'no_marker': True}"/>

                    <p t-if="doc.partner_id.vat"
                       class="mb-0"
                       style="margin: 4px 0 0 0; font-weight: 600;">
                        <t t-if="doc.company_id.account_fiscal_country_id.vat_label"
                           t-out="doc.company_id.account_fiscal_country_id.vat_label"/>
                        <t t-else="">Tax ID</t>:
                        <span t-field="doc.partner_id.vat"/>
                    </p>
                </div>
            </t>

            <t t-else="">
                <div class="customer_address_en"
                     dir="ltr"
                     style="width: 42%; margin-left: 0; margin-right: auto; text-align: left; direction: ltr; font-size: 15px; line-height: 1.35; font-weight: 600;">

                    <div t-field="doc.partner_id"
                         class="mb-0"
                         t-options="{'widget': 'contact', 'fields': ['address', 'name'], 'no_marker': True}"/>

                    <p t-if="doc.partner_id.vat"
                       class="mb-0"
                       style="margin: 4px 0 0 0; font-weight: 600;">
                        <t t-if="doc.company_id.account_fiscal_country_id.vat_label"
                           t-out="doc.company_id.account_fiscal_country_id.vat_label"/>
                        <t t-else="">Tax ID</t>:
                        <span t-field="doc.partner_id.vat"/>
                    </p>
                </div>
            </t>
        </t>

    </xpath>
</template>

    <!-- document_title -->
    <template id="custom_external_layout_striped_body_title_shape" inherit_id="web.external_layout_striped" priority="60">
    <xpath expr="//h2[@t-out='layout_document_title']" position="attributes">
        <attribute name="t-att-style">
            (
                o and (
                    o._name == 'sale.order'
                    or (
                        o._name == 'account.move'
                        and o.move_type in ('out_invoice', 'out_refund')
                    )
                )
            )
            and
            'display: table; margin: 18px auto 28px auto; min-width: 30%; max-width: 80%; padding: 13px 20px; border: 1px solid #1e5397; border-radius: 20px; color: #1e5397; background: transparent; font-size: 20px; font-weight: 600; text-align: center; direction: rtl;'
            or
            'margin: 0; padding: 0;'
        </attribute>
    </xpath>
</template>



    <!-- informatin box -->
    <template id="custom_sale_report_information_box" inherit_id="sale.report_saleorder_document" priority="90">
        <xpath expr="//div[@id='informations']" position="before">
            <style type="text/css">
            #informations {
                background-color: rgba(231, 233, 237, 0.5);
                border-radius: 18px !important;
                padding: 16px 22px !important;
                box-sizing: border-box !important;
                display: table !important;
                width: 100% !important;
                table-layout: fixed !important;
                margin-top: 10px !important;
                margin-bottom: 24px !important;
                border: 0 !important;
            }

            #informations > div {
                display: table-cell !important;
                float: none !important;
                width: auto !important;
                max-width: none !important;
                text-align: center !important;
                vertical-align: top !important;
                padding: 4px 10px !important;
                border: 0 !important;
                background-color: transparent !important;
                box-sizing: border-box !important;
            }

            #informations strong {
                display: block !important;
                color: #1e5397 !important;
                font-size: 18px !important;
                font-weight: 600 !important;
                margin-bottom: 4px !important;
                text-align: center !important;
            }

            #informations > div > div {
                color: #111827a6 !important;
                font-size: 20px !important;
                font-weight: 400 !important;
                text-align: center !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            </style>
        </xpath>


        <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="style">
            border-radius: 18px !important;
            padding: 16px 22px !important;
            box-sizing: border-box !important;
            display: table !important;
            width: 100% !important;
            table-layout: fixed !important;
            margin-top: 10px !important;
            margin-bottom: 24px !important;
            border: 0 !important;
            </attribute>
        </xpath>

    </template>

