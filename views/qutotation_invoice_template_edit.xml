<template id="custom_invoice_dynamic_address_content">

    <t t-set="partner_lang" t-value="o.partner_id.lang or ''"/>
    <t t-set="is_arabic_partner" t-value="partner_lang.startswith('ar')"/>

    <style type="text/css">
        .o_snail_mail .address {
            padding-top: 0px !important;
        }

        .address.row,
        .address.row.mb-4 {
            width: 100% !important;
            max-width: 100% !important;
            margin-left: 0 !important;
            margin-right: 0 !important;
            padding-left: 0 !important;
            padding-right: 0 !important;
            clear: both !important;
            overflow: visible !important;
        }

        .address.row > div[name="address"],
        .address.row.mb-4 > div[name="address"] {
            display: block !important;
            width: 100% !important;
            max-width: 100% !important;
            flex: none !important;
            float: none !important;
            margin-left: 0 !important;
            margin-right: 0 !important;
            padding-left: 0 !important;
            padding-right: 0 !important;
            overflow: visible !important;
        }

        .custom_dynamic_address_wrapper {
            display: block !important;
            width: 100% !important;
            max-width: 100% !important;
            clear: both !important;
            overflow: visible !important;
            page-break-inside: avoid !important;
        }

        .custom_dynamic_address_box {
            display: inline-block !important;
            width: 42% !important;
            max-width: 42% !important;
            vertical-align: top !important;
            font-size: 18px !important;
            line-height: 1.35 !important;
            font-weight: 600 !important;
            box-sizing: border-box !important;
            color: #000000 !important;
            overflow: visible !important;
        }

        .custom_dynamic_address_ar,
        .custom_dynamic_address_ar * {
            direction: rtl !important;
            text-align: right !important;
            font-weight: 600 !important;
        }

        .custom_dynamic_address_en,
        .custom_dynamic_address_en * {
            direction: ltr !important;
            text-align: left !important;
            font-weight: 600 !important;
        }
    </style>

    <!-- Arabic Customer: address on right -->
    <t t-if="is_arabic_partner">

        <style type="text/css">
            .address.row,
            .address.row.mb-4 {
                direction: rtl !important;
                text-align: right !important;
            }
        </style>

        <div class="custom_dynamic_address_wrapper custom_dynamic_address_ar"
             dir="rtl"
             style="width:100%; text-align:right; direction:rtl;">

            <div class="custom_dynamic_address_box"
                 style="margin-left:0; margin-right:0; text-align:right; direction:rtl;">

                <div t-field="o.partner_id"
                     class="mb-0"
                     t-options="{'widget': 'contact', 'fields': ['address', 'name'], 'no_marker': True}"/>

                <p t-if="o.partner_id.vat"
                   class="mb-0"
                   style="margin:4px 0 0 0; font-weight:600;">
                    <t t-if="o.company_id.account_fiscal_country_id.vat_label"
                       t-out="o.company_id.account_fiscal_country_id.vat_label"/>
                    <t t-else="">Tax ID</t>:
                    <span t-field="o.partner_id.vat"/>
                </p>

            </div>
        </div>

    </t>

    <!-- English Customer: address on left -->
    <t t-else="">

        <style type="text/css">
            .address.row,
            .address.row.mb-4 {
                direction: ltr !important;
                text-align: left !important;
            }
        </style>

        <div class="custom_dynamic_address_wrapper custom_dynamic_address_en"
             dir="ltr"
             style="width:100%; text-align:left; direction:ltr;">

            <div class="custom_dynamic_address_box"
                 style="margin-left:0; margin-right:0; text-align:left; direction:ltr;">

                <div t-field="o.partner_id"
                     class="mb-0"
                     t-options="{'widget': 'contact', 'fields': ['address', 'name'], 'no_marker': True}"/>

                <p t-if="o.partner_id.vat"
                   class="mb-0"
                   style="margin:4px 0 0 0; font-weight:600;">
                    <t t-if="o.company_id.account_fiscal_country_id.vat_label"
                       t-out="o.company_id.account_fiscal_country_id.vat_label"/>
                    <t t-else="">Tax ID</t>:
                    <span t-field="o.partner_id.vat"/>
                </p>

            </div>
        </div>

    </t>

</template>


    
    <!-- Apply to all invoice address branches -->
    <template id="custom_invoice_report_customer_address_by_language" inherit_id="account.report_invoice_document" priority="95">
        <!-- Case 1: shipping address different -->
        <xpath expr="//div[@name='address_not_same_as_shipping']/t[@t-set='address']" position="replace">
            <t t-set="address">
                <t t-call="zofirm_contract.custom_invoice_dynamic_address_content"/>
            </t>
        </xpath>
        <!-- Case 2: shipping address same as invoice address -->
        <xpath expr="//div[@name='address_same_as_shipping']/t[@t-set='address']" position="replace">
            <t t-set="address">
                <t t-call="zofirm_contract.custom_invoice_dynamic_address_content"/>
            </t>
        </xpath>
        <!-- Case 3: no shipping address -->
        <xpath expr="//div[@name='no_shipping']/t[@t-set='address']" position="replace">
            <t t-set="address">
                <t t-call="zofirm_contract.custom_invoice_dynamic_address_content"/>
            </t>
        </xpath>
    </template>



    <!-- Information Box -->
    <template id="custom_invoice_report_information_box" inherit_id="account.report_invoice_document" priority="90">
        <xpath expr="//div[@id='informations']" position="before">
            <style type="text/css">
            #informations {
                background-color: rgba(231, 233, 237, 0.5);
                border-radius: 18px !important;
                padding: 16px 22px !important;
                box-sizing: border-box !important;
                display: table !important;
                width: 100% !important;
                table-layout: fixed !important;
                margin-top: 10px !important;
                margin-bottom: 24px !important;
                border: 0 !important;
            }

            #informations > div {
                display: table-cell !important;
                float: none !important;
                width: auto !important;
                max-width: none !important;
                text-align: center !important;
                vertical-align: top !important;
                padding: 4px 10px !important;
                border: 0 !important;
                background-color: transparent !important;
                box-sizing: border-box !important;
            }

            #informations strong {
                display: block !important;
                color: #1e5397 !important;
                font-size: 18px !important;
                font-weight: 600 !important;
                margin-bottom: 4px !important;
                text-align: center !important;
            }

            #informations strong br {
                display: none !important;
            }

            #informations > div > div {
                color: #111827a6 !important;
                font-size: 20px !important;
                font-weight: 400 !important;
                text-align: center !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            </style>
        </xpath>


        <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="style">
            border-radius: 18px !important;
            padding: 16px 22px !important;
            box-sizing: border-box !important;
            display: table !important;
            width: 100% !important;
            table-layout: fixed !important;
            margin-top: 10px !important;
            margin-bottom: 24px !important;
            border: 0 !important;
            </attribute>
        </xpath>

    </template>
    <!-- main table -->
    <template id="custom_invoice_main_table_colors_radius_only" inherit_id="account.report_invoice_document" priority="100">
        <xpath expr="//table[hasclass('o_main_table')]" position="before">
            <style type="text/css">
            .o_main_table {
                border-radius: 18px !important;
                border-collapse: separate !important;
                border-spacing: 0 !important;
                overflow: hidden !important;
            }
            .o_main_table thead th {
                color: #1e5397 !important;
                font-weight: 200 !important;
            }
            .o_main_table thead th span {
                color: #1e5397 !important;
                font-weight: 200 !important;
            }
            .o_total_table tr.o_total td,
            .o_total_table tr.o_total strong {
                color: #1e5397 !important;
                font-weight: 600 !important;
            }
                
            .o_total_table tbody{
                border-radius: 18px !important;
                }
            </style>
        </xpath>
        <xpath expr="//table[hasclass('o_main_table')]" position="attributes">
            <attribute name="style">
            border-radius: 18px !important;
            border-collapse: separate !important;
            border-spacing: 0 !important;
            overflow: hidden !important;
            width: 100% !important;
            padding: 10px !important;
            </attribute>
        </xpath>
    </template>
    <!-- total table -->
    <template id="custom_invoice_total_table_radius_only" inherit_id="account.report_invoice_document" priority="140">
        <xpath expr="//table[hasclass('o_total_table')]" position="before">
            <style type="text/css">
            #right-elements .o_total_table {
                background-color: rgba(231, 233, 237, 0.5);
                border-collapse: separate !important;
                border-spacing: 0 !important;
                border-radius: 18px !important;
                overflow: hidden !important;
                margin-top: 2px !important;
            }

            #right-elements .o_total_table td {
                background-color: rgba(231, 233, 237, 0.5);
                padding: 10px 12px !important;
                border: 0 !important;
            }

            #right-elements .o_total_table tr:first-child td:first-child {
                border-top-left-radius: 18px !important;
            }

            #right-elements .o_total_table tr:first-child td:last-child {
                border-top-right-radius: 18px !important;
            }

            #right-elements .o_total_table tr:last-child td:first-child {
                border-bottom-left-radius: 18px !important;
            }

            #right-elements .o_total_table tr:last-child td:last-child {
                border-bottom-right-radius: 18px !important;
            }

            #right-elements .o_total_table tr.o_total td,
