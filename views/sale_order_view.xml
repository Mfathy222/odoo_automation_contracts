<odoo>

    <record id="view_order_form_inherit_fees_period_end" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.fees.period.end</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">
                <field name="is_sijil_company" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='product_template_id']" position="after">
                <field name="payment_duration_id" options="{ 'no_create': True, 'no_create_edit': True}" column_invisible="parent.is_sijil_company"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='payment_duration_id']" position="after">
                <field name="fees_period_start" column_invisible="parent.is_sijil_company"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='fees_period_start']" position="after">
                <field name="fees_period_end" column_invisible="parent.is_sijil_company"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='fees_period_end']" position="after">
                <field name="financial_year_ids" string="Years" widget="many2many_tags" column_invisible="parent.is_sijil_company" />
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='financial_year_ids']" position="after">
                <field name="financial_quarter_ids" string="Quarter" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}" column_invisible="parent.is_sijil_company"/>
            </xpath>

        </field>
    </record>

<record id="sale.action_report_saleorder" model="ir.actions.report">
    <field name="print_report_name">(object.state in ('draft', 'sent') and 'Quotation - %s - %s' % (object.name or '', object.partner_id.commercial_company_name or object.partner_id.name or '')) or 'Order - %s - %s' % (object.name or '', object.partner_id.commercial_company_name or object.partner_id.name or '')</field>
</record>

    <record id="view_order_form_inherit_project_schedule" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.project.schedule</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority" eval="16"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[.//field[@name='order_line']]" position="after">
                <page string="Project schedule" invisible="not is_sijil_company">
                    <group>
                        <field name="project_schedule_line_ids" context="{'default_order_id': id}" string="">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="description"/>
                                <field name="duration_per_week"/>
                                <field name="outputs"/>
                            </list>
                            <form string="Project schedule line">
                                <group>
                                    <field name="sequence"/>
                                    <field name="description"/>
                                    <field name="duration_per_week"/>
                                    <field name="outputs" widget="text"/>
                                </group>
                            </form>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>


    <record id="view_order_form_inherit_zofirm_contract_button" model="ir.ui.view">
        <field name="name">sale.order.form.zofirm.contract.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- الفيلدين الهيدن اللي هنعتمد عليهم في الشروط -->
            <xpath expr="//sheet" position="inside">
                <field name="has_contract" invisible="1"/>
                <field name="is_sijil_company" invisible="1"/>
                <field name="can_manage_contracts" invisible="1"/>
                <field name="contract_count" invisible="1"/>
                <field name="is_company_1" invisible="1"/>
                <field name="is_company_1_or_2" invisible="1"/>
            </xpath>

            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_quotation_contracts" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="contract_count == 0" groups="zofirm_contract.group_zofirm_contract_manager,zofirm_contract.group_sijil_contract_manager,base.group_system">
                    <field name="contract_count" widget="statinfo" string="contract"/>
                </button>
            </xpath>


            <xpath expr="//header" position="inside">
                <button name="action_print_zofirm" type="object" class="oe_highlight" string="Print Zofirm" invisible="not is_company_1"/>
                <button name="action_print_4400_qut" type="object" string="4400" class="oe_highlight" invisible="not is_company_1"/>
                <button name="action_create_contract" type="object" class="oe_highlight" string="Create Contract" invisible="not can_manage_contracts or has_contract or not is_company_1_or_2" groups="zofirm_contract.group_zofirm_contract_manager,zofirm_contract.group_sijil_contract_manager,base.group_system"/>
                <button name="action_create_contract" type="object" class="oe_highlight" string="Update Contract" invisible="not can_manage_contracts or not has_contract or not is_company_1_or_2" groups="zofirm_contract.group_zofirm_contract_manager,zofirm_contract.group_sijil_contract_manager,base.group_system"/>
            </xpath>

            <!--  Tab: Fees and Payments بعد Order Lines مباشرة -->
            <xpath expr="//sheet/notebook/page[1]" position="after">
                <page string="Fees and Payments" invisible="not is_sijil_company">
                    <field name="fees_payment_line_ids">
                        <list editable="bottom">
                            <field name="name" string="الدفعة"/>
                            <field name="percentage_total" string="النسبة من القيمة الإجمالية"/>
                            <field name="amount" string="المبلغ (ريال سعودي)"/>
                            <field name="due_stage" string="مرحلة الاستحقاق"/>
                        </list>
                        <form>
                            <group>
                                <field name="name" string="الدفعة"/>
                                <field name="percentage_total" string="النسبة من القيمة الإجمالية"/>
                                <field name="amount" string="المبلغ (ريال سعودي)"/>
                                <field name="due_stage" string="مرحلة الاستحقاق"/>
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <record id="view_sijil_contract_create_wizard_form" model="ir.ui.view">
        <field name="name">sijil.contract.create.wizard.form</field>
        <field name="model">sijil.contract.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Sijillacc Contract">
                <sheet>
                    <group>
                        <field name="sale_order_id" invisible="1"/>
                        <field name="contract_type" widget="radio"/>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="contract_type != 'sijil_maintenance_contract'">
                        امسح أي خدمة أو منتج لا تريد إدخاله داخل عقد الصيانة. السطور المتبقية فقط هي التي سيتم حفظها على العقد.
                    </div>
                    <field name="line_ids" invisible="contract_type != 'sijil_maintenance_contract'">
                        <list editable="bottom" create="0" delete="1">
                            <field name="sale_line_id" column_invisible="1" force_save="1"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="name" readonly="1"/>
                            <field name="product_uom_qty" readonly="1"/>
                            <field name="product_uom_id" readonly="1"/>
                            <field name="price_unit" readonly="1"/>
                            <field name="price_subtotal" readonly="1"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_create_contract" type="object" string="Create Contract" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>



    <!-- =========================================================
         Payment Duration Configuration
         Sales > Configuration > Payment Duration
         ========================================================= -->

    <record id="view_sale_payment_duration_list" model="ir.ui.view">
        <field name="name">sale.payment.duration.list</field>
        <field name="model">sale.payment.duration</field>
        <field name="arch" type="xml">
            <list string="Payment Durations" editable="bottom" default_order="sequence, name">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sale_payment_duration_form" model="ir.ui.view">
        <field name="name">sale.payment.duration.form</field>
        <field name="model">sale.payment.duration</field>
        <field name="arch" type="xml">
            <form string="Payment Duration">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sale_payment_duration" model="ir.actions.act_window">
        <field name="name">Payment Duration</field>
        <field name="res_model">sale.payment.duration</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Payment Duration
            </p>
            <p>
                Add the payment duration options that can be selected on quotation lines.
            </p>
        </field>
    </record>


    <menuitem id="menu_sale_payment_duration" name="Payment Duration" parent="sale.menu_sale_config" action="action_sale_payment_duration" sequence="10" groups="sales_team.group_sale_manager" />
</odoo>
