<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="seq_zofirm_contract" model="ir.sequence">
      <field name="name">zofirm Contract</field>
      <field name="code">zofirm.contract</field>
      <field name="prefix">%(year)s/</field>
      <field name="padding">4</field>
      <field name="company_id" eval="False"/>
      <field name="implementation">no_gap</field>
    </record>

    <record id="seq_sijil_contract" model="ir.sequence">
      <field name="name">Sijil Contract</field>
      <field name="code">sijil.contract</field>
      <field name="prefix">%(year)s/</field>
      <field name="padding">4</field>
      <field name="company_id" eval="False"/>
      <field name="implementation">no_gap</field>
    </record>

  <record id="seq_sijil_maintenance_contract" model="ir.sequence">
    <field name="name">Sijil Maintenance Contract</field>
    <field name="code">sijil.maintenance.contract</field>
    <field name="prefix">%(year)s/M</field>
    <field name="padding">4</field>
    <field name="company_id" eval="False"/>
    <field name="implementation">no_gap</field>
  </record>
  </data>

</odoo>
