<odoo>
    <record id="group_zofirm_contract_manager" model="res.groups">
        <field name="name">Zofirm Contracts Manager</field>
    </record>

    <record id="group_sijil_contract_manager" model="res.groups">
        <field name="name">Sijil Contracts Manager</field>
    </record>

    <record id="zofirm_contract_multi_company_rule" model="ir.rule">
        <field name="name">Contracts - allowed companies</field>
        <field name="model_id" ref="model_zofirm_contract"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>


    <record id="sign_request_rule_sijil_contract_manager" model="ir.rule">
        <field name="name">Sign Requests - Sijil Contract Managers</field>
        <field name="model_id" ref="sign.model_sign_request"/>
        <field name="groups" eval="[ (4, ref('zofirm_contract.group_sijil_contract_manager')) ]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('template_id.sijil_contract_id.company_id', 'in', company_ids)]</field>
    </record>

</odoo>
